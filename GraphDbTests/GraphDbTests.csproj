<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GraphRoots.GraphDbTests</RootNamespace>
    <AssemblyName>GraphDbTests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <Description>GraphRoots tests</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Neo4j.Driver" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GraphDb.Neo4j\GraphDb.Neo4j.csproj" />
    <ProjectReference Include="..\GrasshopperLib\GrasshopperLib.csproj" />
    <ProjectReference Include="..\GraphStoreContractTests\GraphStoreContractTests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="GH_IO">
      <HintPath>..\lib\GH_IO.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\testdata\**\*" Link="testdata\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
