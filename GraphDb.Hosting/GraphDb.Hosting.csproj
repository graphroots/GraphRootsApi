<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GraphRoots.GraphDb.Hosting</RootNamespace>
    <AssemblyName>GraphDb.Hosting</AssemblyName>
    <Description>Selects and registers the configured GraphRoots storage backend</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- One reference per storage backend. Hosts (GraphApi, GraphDbCli) reference this project, not a backend. -->
    <ProjectReference Include="..\GraphDb.Neo4j\GraphDb.Neo4j.csproj" />
  </ItemGroup>
</Project>
